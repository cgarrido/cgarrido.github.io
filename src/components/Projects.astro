---
import { en } from '../i18n/en';
import { es } from '../i18n/es';
---
<section id="projects" class="py-24">
  <div class="container">
    <h2 class="section-title animate-in">
      <span class="lang-en">{en.projects.title}</span>
      <span class="lang-es">{es.projects.title}</span>
    </h2>
    <p class="text-muted text-sm mb-10 animate-in">
      <span class="lang-en">{en.projects.subtitle}</span>
      <span class="lang-es">{es.projects.subtitle}</span>
    </p>

    <div class="grid gap-6 md:grid-cols-2">
      {en.projects.items.map((item, i) => (
        <div class="project-card animate-in">
          <div class="flex items-start justify-between gap-3 mb-1">
            <h3 class="text-text font-semibold text-lg">
              {item.url ? (
                <a href={item.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">{item.name}<span aria-hidden="true"> ↗</span></a>
              ) : (
                <span class="lang-en">{item.name}</span>
              )}
              {!item.url && <span class="lang-es">{es.projects.items[i].name}</span>}
            </h3>
          </div>
          <p class="text-accent-light text-xs font-mono mb-3">
            <span class="lang-en">{item.role}</span>
            <span class="lang-es">{es.projects.items[i].role}</span>
          </p>
          <p class="text-muted text-sm leading-relaxed mb-4">
            <span class="lang-en">{item.description}</span>
            <span class="lang-es">{es.projects.items[i].description}</span>
          </p>
          <div class="flex flex-wrap gap-2">
            {item.tags.map(tag => <span class="pill">{tag}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .project-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1.25rem;
  }
</style>
